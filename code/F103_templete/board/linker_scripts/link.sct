; *************************************************************
; *** Scatter-Loading Description File for STM32F103C8T6    ***
; *** Flash: 64KB (0x10000), RAM: 20KB (0x5000)             ***
; *************************************************************

LR_IROM1 0x08000000 0x00010000  {    ; 加载域：Flash 起始地址及大小（64KB）
  ER_IROM1 0x08000000 0x00010000  {  ; 执行域：Flash 运行空间
    *.o (RESET, +First)
    *(InRoot$$Sections)
    .ANY (+RO)
  }
  RW_IRAM1 0x20000000 0x00005000  {  ; 运行域：SRAM 起始地址及大小（20KB）
    .ANY (+RW +ZI)
  }
}