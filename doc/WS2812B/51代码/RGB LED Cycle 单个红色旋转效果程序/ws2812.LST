 155          //子程序名称:SendOneFrame(unsigned char *ptr)
 156          //功能：发送一帧数据（即发送整个数组的数据）
 157          //参数：接收的参数是一个指针，此函数会将此指针指向的地址的整个数组的数据发送
 158          //-------------------------------------------------------------------------------
 159          void SendOneFrame(unsigned char *ptr)
 160          {
 161   1              unsigned char k;
 162   1      
 163   1              ResetDataFlow();                                 //发送帧复位信号
 164   1      
 165   1              for(k=0;k<SNUM;k++)                              //发送一帧数据，SNUM是板子LED的个数
 166   1              {
 167   2                      SendOnePix(&ptr[(3*k)]);
 168   2              }
 169   1      
 170   1              ResetDataFlow();                                 //发送帧复位信号
 171   1      }
