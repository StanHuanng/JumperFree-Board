 191          //-------------------------------------------------------------------------------
 192          //子程序名称:SendOneFrameFrom(unsigned char i,unsigned char *ptr)
 193          //功能：从指定的像素点开始发送一帧数据（即发送整个数组的数据）
 194          //参数：接收的参数是一个指针，此函数会将此指针指向的地址的整帧数据发送
 195          //              i:把数组的第0个像素数据发送到第i个像素点（第0个像素是板上标号为01的像素）
 196          //说明：即原本对应第一个像素的数据会发送到第i个像素点（LED）上
 197          //-------------------------------------------------------------------------------
 198          void SendOneFrameFrom(unsigned char i,unsigned char *ptr)
 199          {
 200   1              unsigned char k;
 201   1      
 202   1              ResetDataFlow();                                 //发送帧复位信号
 203   1      
 204   1              for(k=(SNUM-i);k<SNUM;k++)               //发送一帧数据
 205   1              {
 206   2                      SendOnePix(&ptr[(3*k)]);
 207   2              }
 208   1              for(k=0;k<(SNUM-i);k++)
 209   1              {
 210   2                      SendOnePix(&ptr[(3*k)]);
 211   2              }
 212   1      
 213   1              ResetDataFlow();                                 //发送帧复位信号
 214   1      }
