  52   1      
  53   1              if(Button_1==0)                         //如果按键1被按下
  54   1              {
  55   2                      DelayMs(10);                    //延时10毫秒后判断
C51 COMPILER V9.01   KEYPAD                                                                12/13/2015 16:08:50 PAGE 2   

