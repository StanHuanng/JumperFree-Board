 125          //子程序名称:System_Init(void)
 126          //功能：端口初始化，使能中断
 127          //-------------------------------------------------------------------------------
 128          void System_Init(void)
 129          {
 130   1              BTN1=1;
 131   1              BTN2=1;
 132   1      
 133   1              //使能INT0中断
 134   1              INT0 = 1;
 135   1          IT0 = 1;                    //设置INT0的中断类型 (1:仅下降沿 0:上升沿和下降沿)
 136   1          EX0 = 1;                    //使能INT0中断
 137   1              
 138   1              //使能INT1中断
 139   1              INT1 = 1;
 140   1          IT1 = 1;                    //设置INT1的中断类型 (1:仅下降沿 0:上升沿和下降沿)
 141   1          EX1 = 1;                    //使能INT1中断
 142   1      }
 143          /**************************************中断服务程序*********************************/
 144          //按键1中断入口:模式切换
 145          void Btn1Int() interrupt 0          
 146          {
 147   1              //进来先关中断
 148   1              EA = 0;
 149   1              INT_CLKO &= 0xEF;           
 150   1              INT_CLKO &= 0xDF;  
 151   1              
 152   1              //延时一段时间
 153   1              DelayMs(40);
 154   1              
 155   1              mode++;
 156   1              if(mode==4)
 157   1              {
 158   2                      mode=0;
 159   2              }
 160   1              //走时开中断
 161   1              EA = 1;
 162   1              INT_CLKO |= 0x10;              
 163   1              INT_CLKO |= 0x20;                               
 164   1      }
 165          //按键2中断入口:控制颜色切换
 166          void Btn2Int() interrupt 2        
