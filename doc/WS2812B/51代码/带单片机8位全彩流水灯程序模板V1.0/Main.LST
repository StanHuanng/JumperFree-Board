 322          void System_Init(void)
 323          {
 324   1              BTN1=1;
 325   1              BTN2=1;
 326   1      
 327   1              //使能INT0中断
 328   1              INT0 = 1;
 329   1          IT0 = 1;                    //设置INT0的中断类型 (1:仅下降沿 0:上升沿和下降沿)
 330   1          EX0 = 1;                    //使能INT0中断
 331   1              
 332   1              //使能INT1中断
 333   1              INT1 = 1;
 334   1          IT1 = 1;                    //设置INT1的中断类型 (1:仅下降沿 0:上升沿和下降沿)
 335   1          EX1 = 1;                    //使能INT1中断
 336   1      }
 337          /**************************************中断服务程序*********************************/
 338          //按键1中断入口:模式切换
 339          void Btn1Int() interrupt 0          
 340          {
 341   1              //进来先关中断
 342   1              EA = 0;
 343   1              INT_CLKO &= 0xEF;           
 344   1              INT_CLKO &= 0xDF;  
 345   1              
 346   1              //延时一段时间
 347   1              DelayMs(40);
 348   1              
 349   1              mode++;
 350   1              if(mode==6)
 351   1              {
 352   2                      mode=0;
 353   2              }
 354   1              //走时开中断
C51 COMPILER V9.54   MAIN                                                                  04/16/2016 18:40:38 PAGE 7   

 355   1              EA = 1;
 356   1              INT_CLKO |= 0x10;              
 357   1              INT_CLKO |= 0x20;                               
 358   1      }
