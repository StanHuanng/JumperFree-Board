  52          //-------------------------------------------------------------------------------
  53          //子程序名称:unsigned char GetKey(void)
  54          //功能：获得被按下的键的键值
  55          //说明：按键1被按下时，返回1，按键2被按下时返回2，没有按键按下时返回0
C51 COMPILER V9.01   KEYPAD                                                                01/27/2016 10:48:01 PAGE 2   

  56          //-------------------------------------------------------------------------------
  57          unsigned char GetKey(void)
  58          {
  59   1              unsigned char i;
  60   1              Button_1=1;
  61   1              Button_2=1;
  62   1      
  63   1              if(Button_1==0)                         //如果按键1被按下
  64   1              {
  65   2                      DelayMs(10);                    //延时10毫秒后判断
  66   2                      if(Button_1==0)                                  
  67   2                      {
  68   3                              for(i=0;i<100;i++)
  69   3                              {
  70   4                                      if(Button_1==1) //在超时时间内按键被松开，则认为按键1触发有效
  71   4                                      {
  72   5                                              return 1;       //返回结果1，代表按键1被按下
  73   5                                      }
  74   4                                      DelayMs(10);    //超时时间为1秒，如果超过1秒按键没抬起，则认为按下无效
  75   4                              }
  76   3                      }
  77   2              }
  78   1              if(Button_2==0)                         //如果按键1没有被按下，开始判断按键2
  79   1              {
  80   2                      DelayMs(10);
  81   2                      if(Button_2==0)
  82   2                      {
  83   3                              for(i=0;i<100;i++)
  84   3                              {
  85   4                                      if(Button_2==1) //在超时时间内按键被松开，则认为按键1触发有效
  86   4                                      {
  87   5                                              return 2;       //返回结果1，代表按键1被按下
  88   5                                      }
  89   4                                      DelayMs(10);    //超时时间为1秒
  90   4                              }
  91   3                      }
  92   2              }
  93   1              return 0;
  94   1      }


