  33          //子程序名称:IO_Init(void)
  34          //功能：端口初始化，使能中断
  35          //-------------------------------------------------------------------------------
  36          void Keypad_IO_Init(void)
  37          {
  38   1              Button_1=1;
  39   1              Button_2=1;
  40   1      
  41   1              //使能INT0中断
  42   1              INT0 = 1;
  43   1          IT0 = 1;                    //设置INT0的中断类型 (1:仅下降沿 0:上升沿和下降沿)
  44   1          EX0 = 1;                    //使能INT0中断
  45   1              
  46   1              //使能INT1中断
  47   1              INT1 = 1;
  48   1          IT1 = 1;                    //设置INT1的中断类型 (1:仅下降沿 0:上升沿和下降沿)
  49   1          EX1 = 1;                    //使能INT1中断
  50   1      }
